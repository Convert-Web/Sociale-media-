# ---------------------------------------------------------------
# AURUM — configuration (copiez ce fichier en .env et complétez)
# ---------------------------------------------------------------

# Adresse publique du site (sert aux liens de paiement et aux e-mails)
BASE_URL=http://localhost:3000
PORT=3000

# En production : NODE_ENV=production (cookies sécurisés, mode démo désactivé)
# NODE_ENV=production

# --- Droit d'entrée ------------------------------------------------
# false (par défaut) : inscription gratuite, accès immédiat.
# true : paiement obligatoire pour entrer (configurez Stripe ci-dessous).
PAID_ENTRY=false

# --- Paiement Stripe (seulement si PAID_ENTRY=true) ---------------
# Clé secrète : https://dashboard.stripe.com/apikeys  (sk_test_… pour tester, sk_live_… en réel)
STRIPE_SECRET_KEY=
# Secret du webhook : https://dashboard.stripe.com/webhooks  (ou « stripe listen » en local)
STRIPE_WEBHOOK_SECRET=

# Droit d'entrée en centimes (999 = 9,99 €) et devise
ENTRY_PRICE_CENTS=999
CURRENCY=eur

# Nombre de membres « Fondateurs » (carte or + couronne)
FOUNDER_LIMIT=100

# Paiement simulé : actif par défaut en développement quand aucune clé Stripe n'est fournie.
# Ne jamais activer en production.
# DEMO_PAYMENTS=false

# --- Administration --------------------------------------------
# E-mails ayant accès au tableau de bord « Direction » (séparés par des virgules).
# Laissé vide : le tout premier compte créé devient administrateur.
ADMIN_EMAILS=

# --- E-mails (mot de passe oublié) ------------------------------
# Exemple : smtps://utilisateur:motdepasse@smtp.exemple.com:465
# Sans SMTP, les e-mails s'affichent dans la console du serveur.
SMTP_URL=
MAIL_FROM=AURUM <no-reply@votre-domaine.fr>

# --- Base de données ------------------------------------------------
# En ligne : base Turso gratuite (https://turso.tech), adresse libsql://… et jeton.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Sans Turso : fichier SQLite local dans ce dossier (comptes, publications et photos).
DATA_DIR=./data
