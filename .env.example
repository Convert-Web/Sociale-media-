# ---------------------------------------------------------------
# Vibz — configuration (copie ce fichier en .env et complète-le)
# ---------------------------------------------------------------

# Adresse publique du site (liens des courriels et du paiement)
BASE_URL=http://localhost:3000
PORT=3000
# Nom affiché de l'application
APP_NAME=Vibz

# En production : NODE_ENV=production (cookies sécurisés, achats simulés désactivés)
# NODE_ENV=production

# --- Base de données ---------------------------------------------
# En ligne : base Turso gratuite (https://turso.tech), adresse libsql://… et jeton.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Sans Turso : fichier SQLite local dans ce dossier (data/vibz.db).
DATA_DIR=./data

# --- Vidéos --------------------------------------------------------
# Durée maximale d'une vidéo, en secondes (180 = 3 min ; 600 au plus)
VIDEO_MAX_SECONDS=180
# Poids maximal d'une vidéo, en Mo (publiée en qualité d'origine, sans recompression)
VIDEO_MAX_MB=250
# Espace réservé aux vidéos dans la base, en Mo (Turso gratuit : 5 Go au total)
VIDEO_STORAGE_MB=3000
# Durée de vie des vidéos, en heures (0 ou absent : gardées tant que leur auteur ne les supprime pas)
VIDEO_TTL_HOURS=0

# --- LIVE ----------------------------------------------------------
# Spectateurs par LIVE (chacun reçoit l'image directement du téléphone du créateur)
LIVE_MAX_VIEWERS=25
# Serveur TURN (recommandé en production : LIVE fiable derrière les réseaux d'entreprise et
# certains opérateurs mobiles). Exemple avec un service TURN :
# TURN_URL=turn:turn.exemple.com:3478,turns:turn.exemple.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Ou la liste complète au format WebRTC (JSON) :
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:…","username":"…","credential":"…"}]

# --- Pièces (cadeaux du LIVE) : paiement Stripe ----------------------
# Clé secrète : https://dashboard.stripe.com/apikeys  (sk_test_… pour tester, sk_live_… en réel)
STRIPE_SECRET_KEY=
# Secret du webhook : https://dashboard.stripe.com/webhooks  (ou « stripe listen » en local)
STRIPE_WEBHOOK_SECRET=
CURRENCY=eur
# Achats simulés : actifs par défaut en développement quand aucune clé Stripe n'est fournie.
# Jamais en production.
# DEMO_PAYMENTS=false

# --- Administration ----------------------------------------------
# E-mails ayant accès à l'administration (séparés par des virgules).
# Laissé vide : le tout premier compte créé devient administrateur.
ADMIN_EMAILS=

# --- Courriels (bienvenue, mot de passe oublié) -----------------
# Brevo (gratuit, 300 courriels par jour) : clé d'API et expéditeur validé dans Brevo
BREVO_API_KEY=
MAIL_FROM=Vibz <ton-adresse@exemple.fr>
# Ou un serveur SMTP : smtps://utilisateur:motdepasse@smtp.exemple.com:465
SMTP_URL=

# --- Traduction automatique ----------------------------------------
# Gratuit sans réglage (MyMemory). Une adresse e-mail relève le quota ; DeepL donne plus de volume.
TRANSLATE_EMAIL=
DEEPL_API_KEY=

# --- Temps réel ----------------------------------------------------
# « sse » (connexion permanente, serveur classique) ou « poll » (rafraîchissement régulier,
# obligatoire sur Vercel). Choisi automatiquement si absent.
# REALTIME=sse

# --- Démonstration -------------------------------------------------
# true : ajoute le contenu de démonstration au premier démarrage (développement uniquement).
# Sinon : « npm run seed », ou Administration → Démo.
SEED_DEMO=false
